rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- who is the admin ----
    // These must be the login emails of admin accounts that ALREADY EXIST
    // (username + "@nailmaker.local", lowercase). If one of these usernames has
    // never been registered, anyone could sign up with it and become admin:
    // delete any entry you haven't actually registered.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['nailmaker@nailmaker.local', 'mining@nailmaker.local'];
    }

    // Kicked players can't post scores until the admin restores them.
    function isBanned() {
      return exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    // ---- your existing rules (plus the ban check and admin delete) ----
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && ((request.auth.uid == uid && !isBanned()) || isAdmin())
                   && request.resource.data.score is number
                   && request.resource.data.score >= 0;
      allow delete: if isAdmin();
    }
    // Saves: the owner reads and writes their own. The admin can READ (never write) any save, so the
    // admin panel can raise leaderboard scores to each player's current life.
    match /saves/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- weekly leaderboard ----
    match /weeks/{weekId}/scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && ((request.auth.uid == uid && !isBanned()) || isAdmin())
                   && request.resource.data.uid == uid
                   && request.resource.data.score is number
                   && request.resource.data.score >= 0;
      allow delete: if isAdmin();
    }

    // ---- public player profiles ----
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- NEW: medallions. Everyone reads; ONLY the admin account writes. ----
    match /medallions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- NEW: gifts from the admin. Only the admin creates them; the receiving
    // player reads and deletes (claims) their own. ----
    match /gifts/{uid}/items/{id} {
      allow create: if isAdmin();
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- NEW: banned players. Logged-in players may READ the list (the leaderboards use it to leave kicked
    // players off); only the admin writes it. ----
    match /banned/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---- NEW: online presence (the green dots). Logged-in players read; each writes only their own heartbeat. ----
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- NEW: global chat. Logged-in players read and post; only the admin deletes.
    // A message must be exactly { uid, name, text, createdAt }, sent as yourself, 1-200 characters,
    // stamped with the server's time, and kicked (banned) players can't post. ----
    match /chat/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && !isBanned()
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 200
                    && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // ---- NEW: site config, e.g. the news ticker. Logged-in players read; admin writes. ----
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
